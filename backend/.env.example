# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commerce_flow?schema=public"

# Secret used to sign JWT auth tokens (added in issues/002).
JWT_SECRET="change-me"

# Port the Express server listens on.
PORT=5000

# Origin allowed to make credentialed CORS requests (the frontend).
FRONTEND_URL="http://localhost:3000"
