# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commerce_flow?schema=public"

# Secret used to sign JWT auth tokens (added in issues/002).
JWT_SECRET="change-me"

# Port the Express server listens on.
PORT=5000

# Origin allowed to make credentialed CORS requests (the frontend).
FRONTEND_URL="http://localhost:3000"

# Set to "true" in deployments where the frontend and backend are on different
# sites, so the auth cookie is issued as SameSite=None; Secure (required for the
# browser to send it on cross-site API calls). Leave unset locally / when they
# share a domain. See DEPLOY.md.
# COOKIE_CROSS_SITE="true"
